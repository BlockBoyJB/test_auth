HTTP_PORT=8000

LOG_LEVEL=info
LOG_OUTPUT=stdout

# FOR LOCAL RUN
#PG_URL=postgres://postgres:1234567890@localhost:5432/postgres

# FOR DOCKER RUN
PG_URL=postgres://postgres:1234567890@postgres:5432/postgres

SIGN_KEY=foobar
AUTH_WEBHOOK=http://localhost:8000/api/v1/webhook
ACCESS_TTL=30m
REFRESH_TTL=24h

POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234567890
POSTGRES_DB=postgres
